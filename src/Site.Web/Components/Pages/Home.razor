@page "/"
@page "/en"
@inject IStringLocalizer<SharedResource> L

<PageTitle>Akay Deliorman | .NET Backend Developer</PageTitle>

<section id="profile" class="hero">
    <h1>@SiteContent.Profile.FullName</h1>
    <p class="headline">@SiteContent.Profile.Headline.Text()</p>
    <p class="muted location">@SiteContent.Profile.Location.Text()</p>

    <div class="hero-links">
        @foreach (var link in SiteContent.ContactLinks)
        {
            <a class="button" href="@link.Url" target="@(link.Url.StartsWith("http") ? "_blank" : null)" rel="noopener">@link.Label.Text()</a>
        }
    </div>
</section>

<section id="projects">
    <h2>@L["Section_FeaturedProjects"]</h2>
    <div class="card-grid">
        @foreach (var project in SiteContent.Projects.Where(p => p.IsFeatured))
        {
            <ProjectCard Project="project" />
        }
    </div>
    <p><a href="@ProjectsUrl">@L["Common_AllProjects"]</a></p>
</section>

<section id="experience">
    <h2>@L["Nav_Experience"]</h2>
    @foreach (var experience in SiteContent.Experiences)
    {
        <article class="card">
            <h3>@experience.Role.Text() – @experience.Company.Text()</h3>
            <p class="muted">@experience.Start.ToString("MMMM yyyy") – @(experience.End?.ToString("MMMM yyyy") ?? L["Common_Present"].Value)</p>

            @foreach (var item in experience.Items)
            {
                <div>
                    @if (item.Title is not null)
                    {
                        <h4>@item.Title.Text()</h4>
                    }
                    @if (item.Technologies.Count > 0)
                    {
                        <ul class="tags">
                            @foreach (var technology in item.Technologies)
                            {
                                <li>@technology</li>
                            }
                        </ul>
                    }
                    <ul>
                        @foreach (var highlight in item.Highlights)
                        {
                            <li>@highlight.Text()</li>
                        }
                    </ul>
                </div>
            }
        </article>
    }
</section>

<section id="skills">
    <h2>@L["Nav_Skills"]</h2>
    @foreach (var group in SiteContent.SkillGroups)
    {
        <h3>@group.Name.Text()</h3>
        <ul class="tags">
            @foreach (var skill in group.Items)
            {
                <li>@skill.Text()</li>
            }
        </ul>
    }
</section>

<section id="education">
    <h2>@L["Section_Education"]</h2>
    <ul>
        @foreach (var education in SiteContent.Educations)
        {
            <li>
                <strong>@education.Degree.Text()</strong> – @education.School.Text() · @education.StartYear – @education.EndYear
                @if (education.Gpa is not null)
                {
                    <span> · @L["Education_Gpa"]: @education.Gpa</span>
                }
            </li>
        }
    </ul>

    <h3>@L["Section_Certificates"]</h3>
    <ul>
        @foreach (var certificate in SiteContent.Certificates)
        {
            <li>
                <strong>@certificate.Name.Text()</strong> – @certificate.Issuer.Text() · @certificate.Year
                @if (certificate.InProgress)
                {
                    <span> (@L["Common_InProgress"])</span>
                }
                @if (certificate.Details is not null)
                {
                    <p>@certificate.Details.Text()</p>
                }
            </li>
        }
    </ul>
</section>

<section id="contact">
    <h2>@L["Section_Contact"]</h2>
    <ul>
        @foreach (var link in SiteContent.ContactLinks)
        {
            <li><a href="@link.Url">@link.Label.Text()</a></li>
        }
    </ul>
</section>

@code {
    private string ProjectsUrl => LocalizedRoutes.IsEnglish ? "/en/projects" : "/projeler";
}