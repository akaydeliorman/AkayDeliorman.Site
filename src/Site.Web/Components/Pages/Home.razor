@page "/"
@page "/en"
@inject IStringLocalizer<SharedResource> L

<PageTitle>Akay Deliorman | .NET Backend Developer</PageTitle>

<section id="profile">
    <h1>Akay Deliorman</h1>
    <p>.NET Backend Developer</p>
</section>

<section id="projects">
    <h2>@L["Section_FeaturedProjects"]</h2>
    <p>@L["Common_ComingSoon"]</p>
</section>

<section id="experience">
    <h2>@L["Nav_Experience"]</h2>
    <p>@L["Common_ComingSoon"]</p>
</section>

<section id="skills">
    <h2>@L["Nav_Skills"]</h2>
    <p>@L["Common_ComingSoon"]</p>
</section>

<section id="education">
    <h2>@L["Section_Education"]</h2>
    <ul>
        @foreach (var education in SiteContent.Educations)
        {
            <li>
                <strong>@education.Degree.Text()</strong> – @education.School.Text() · @education.StartYear – @education.EndYear
                @if (education.Gpa is not null)
                {
                    <span> · @L["Education_Gpa"]: @education.Gpa</span>
                }
            </li>
        }
    </ul>

    <h3>@L["Section_Certificates"]</h3>
    <ul>
        @foreach (var certificate in SiteContent.Certificates)
        {
            <li>
                <strong>@certificate.Name.Text()</strong> – @certificate.Issuer.Text() · @certificate.Year
                @if (certificate.InProgress)
                {
                    <span> (@L["Common_InProgress"])</span>
                }
                @if (certificate.Details is not null)
                {
                    <p>@certificate.Details.Text()</p>
                }
            </li>
        }
    </ul>
</section>

<section id="contact">
    <h2>@L["Section_Contact"]</h2>
    <ul>
        @foreach (var link in SiteContent.ContactLinks)
        {
            <li><a href="@link.Url">@link.Label.Text()</a></li>
        }
    </ul>
</section>