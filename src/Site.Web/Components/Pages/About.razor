@page "/hakkimda"
@page "/en/about"
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Nav_About"] | Akay Deliorman</PageTitle>

<h1>@L["Nav_About"]</h1>
<p>@SiteContent.Profile.Summary.Text()</p>

<h2>@L["About_Location"]</h2>
<p>@SiteContent.Profile.Location.Text()</p>

<h2>@L["About_Citizenship"]</h2>
<p>@SiteContent.Profile.Citizenship.Text()</p>

<h2>@L["About_Languages"]</h2>
<ul>
    @foreach (var language in SiteContent.Profile.Languages)
    {
        <li>@language.Text()</li>
    }
</ul>
