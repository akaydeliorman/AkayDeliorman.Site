@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

<header class="site-header">
    <div class="site-header-inner">
        <a class="brand" href="@HomeUrl">Akay Deliorman</a>

        <nav>
            <a href="@(HomeUrl + "#projects")">@L["Nav_Projects"]</a>
            <a href="@(HomeUrl + "#experience")">@L["Nav_Experience"]</a>
            <a href="@(HomeUrl + "#skills")">@L["Nav_Skills"]</a>
            <NavLink href="@AboutUrl">@L["Nav_About"]</NavLink>
            <a href="@(HomeUrl + "#contact")">@L["Nav_Contact"]</a>
            <a class="lang-toggle" href="@AlternateUrl" data-enhance-nav="false">@(LocalizedRoutes.IsEnglish ? "TR" : "EN")</a>
        </nav>
    </div>
</header>
<main>
    @Body
</main>

<footer class="site-footer">
    © 2026 Akay Deliorman
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string HomeUrl => LocalizedRoutes.IsEnglish ? "/en" : "/";
    private string AboutUrl => LocalizedRoutes.IsEnglish ? "/en/about" : "/hakkimda";

    private string CurrentPath => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
    private string AlternateUrl => LocalizedRoutes.GetAlternatePath(CurrentPath);
}